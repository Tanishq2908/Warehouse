# ── Frontend Prod: multi-stage build → nginx ───────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app
COPY package.json ./
RUN npm install

COPY . .
# In prod the API is served from the same origin via nginx proxy — no hardcode needed
RUN npm run build

# ── Serve with nginx ───────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# nginx config is mounted via docker-compose.prod.yml
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
