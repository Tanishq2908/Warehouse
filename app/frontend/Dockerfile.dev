# ── Frontend Dev: Vite hot-reload ─────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Install deps first (cache layer)
COPY package.json ./
RUN npm install

# Source copied by docker-compose volume mount at runtime
EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
